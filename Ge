    data = await state.get_data()
    media = data.get('entrant_media', [])
    if message.photo:
        media.append({'type': 'photo', 'file_id': message.photo[-1].file_id})
    elif message.video:
        media.append({'type': 'video', 'file_id': message.video.file_id})
    await state.update_data(entrant_media=media)
    await message.answer(
        f"✅ Медиа добавлено ({len(media)}). Отправьте ещё или нажмите Готово.",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="Готово ✅", callback_data="exchange_ready")],
            [InlineKeyboardButton(text="Отменить ❌", callback_data="main_menu")]
        ])
    )

@router.callback_query(F.data == "exchange_ready")
async def exchange_ready(cb: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    lot_id = data.get('join_lot_id')
    entrant_media = data.get('entrant_media', [])
    lot = lots.get(lot_id)

    if not lot or lot['status'] != 'open' or not entrant_media:
        await cb.answer("Ошибка: лот недоступен или нет медиа", show_alert=True)
        await state.clear()
        return

    lot['status'] = 'pending'
    lot['entrant'] = cb.from_user.id
    lot['entrant_media'] = entrant_media
    await state.clear()

    # Пересылаем обе стороны админам
    for admin_id in ADMIN_IDS:
        try:
            await bot.send_message(
                admin_id,
                f"🔁 <b>Новый обмен #{lot_id}</b>\n"
                f"👤 Владелец: <code>{lot['owner']}</code>\n"
                f"👥 Участник: <code>{lot['entrant']}</code>"
            )
            for m in lot['media']:
                await send_media(admin_id, m, caption=f"Владелец (лот #{lot_id})")
            for m in entrant_media:
                await send_media(admin_id, m, caption=f"Участник (обмен #{lot_id})")
            await bot.send_message(
                admin_id,
                f"Обмен #{lot_id} — проверьте и примите решение:",
                reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="✅ Одобрить", callback_data=f"appr_{lot_id}")],
                    [InlineKeyboardButton(text="❌ Отклонить", callback_data=f"rej_{lot_id}")],
                ])
            )
        except Exception as e:
            logging.warning(f"exchange notify admin err: {e}")

    await cb.message.edit_text(
        "✅ Ваша заявка отправлена на проверку администратору. Ожидайте.",
        reply_markup=back_kb()
    )
    await cb.answer()

@router.callback_query(F.data.startswith("appr_"))
async def approve_exchange(cb: CallbackQuery):
    if cb.from_user.id not in ADMIN_IDS:
        return
    lot_id = int(cb.data.split("_")[1])
    lot = lots.get(lot_id)
    if not lot or lot['status'] != 'pending':
        await cb.answer("Обмен недоступен", show_alert=True)
        return

    lot['status'] = 'confirmed'
    owner = lot['owner']
    entrant = lot['entrant']

    # Взаимная пересылка медиа
    for m in lot['media']:
        await send_media(entrant, m, caption="🎉 Ваш обмен завершён!")
    for m in lot['entrant_media']:
        await send_media(owner, m, caption="🎉 Ваш обмен завершён!")

    exchange_success[owner] = exchange_success.get(owner, 0) + 1
    exchange_success[entrant] = exchange_success.get(entrant, 0) + 1

    try:
        await bot.send_message(owner, f"✅ Обмен #{lot_id} успешно завершён!")
        await bot.send_message(entrant, f"✅ Обмен #{lot_id} успешно завершён!")
    except Exception:
        pass

    await cb.message.edit_text(f"✅ Обмен #{lot_id} одобрен")
    await cb.answer("Одобрено")

@router.callback_query(F.data.startswith("rej_"))
async def reject_exchange(cb: CallbackQuery):
    if cb.from_user.id not in ADMIN_IDS:
        return
    lot_id = int(cb.data.split("_")[1])
    lot = lots.get(lot_id)
