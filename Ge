@router.callback_query(F.data.startswith("join_confirm:"))
async def cb_join_confirm(call: CallbackQuery, bot: Bot):
    lot_id = int(call.data.split(":")[1])
    lot = lots.get(lot_id)
    if not lot or lot["status"] != "approved":
        await call.answer("Недоступно", show_alert=True)
        return
    if call.from_user.id != lot["joiner"]:
        await call.answer("Не ваш обмен", show_alert=True)
        return

    owner = lot["owner"]
    joiner = lot["joiner"]
    try:
        await bot.copy_message(joiner, lot["media"][0], lot["media"][1], caption="🎁 Ваш обмен получен")
        await bot.copy_message(owner, lot["joiner_media"][0], lot["joiner_media"][1], caption="🎁 Ваш обмен получен")
    except Exception as e:
        logging.error(f"exchange failed: {e}")
        await call.message.answer("Ошибка при отправке. Обратитесь к админу.")
        return

    success_count[owner] = success_count.get(owner, 0) + 1
    success_count[joiner] = success_count.get(joiner, 0) + 1
    lots.pop(lot_id, None)
    user_to_lot.pop(owner, None)

    try:
        await call.message.edit_text("✅ Обмен завершён! Проверьте новые сообщения.")
    except Exception:
        pass
    try:
        await bot.send_message(owner, "✅ Обмен завершён!")
    except Exception:
        pass
    await call.answer("Успешно")

