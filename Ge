# bot.py — единый файл, БЕЗ базы данных (всё в памяти, сбрасывается при перезапуске)
# pip install aiogram==3.13.1
#
# Переменные окружения:
#   BOT_TOKEN / TELEGRAM_BOT_TOKEN / TELEGRAM_TOKEN / TOKEN / API_TOKEN — токен
#   CHANNEL_LINK, ADMIN_ID, INVITES_FOR_CONTEST, NFT_LINK — опционально

import os
import asyncio
import random
from aiogram import Bot, Dispatcher, Router, F
from aiogram.filters import CommandStart, Command, CommandObject
from aiogram.types import (
    Message, CallbackQuery,
    InlineKeyboardMarkup, InlineKeyboardButton,
    ReplyKeyboardMarkup, KeyboardButton
)
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ParseMode
from aiogram.utils.deep_linking import create_start_link

# =========================
# НАСТРОЙКИ
# =========================
def _get_env(*names, default=None):
    for n in names:
        v = os.getenv(n)
        if v:
            return v
    return default

BOT_TOKEN = _get_env(
    "BOT_TOKEN", "TELEGRAM_BOT_TOKEN", "TELEGRAM_TOKEN", "TOKEN", "API_TOKEN"
)
if not BOT_TOKEN:
    raise RuntimeError("Не найден токен в переменных окружения.")

CHANNEL_LINK = os.getenv("CHANNEL_LINK", "https://t.me/+8ZzwtRJ6xDlmZWMx")
ADMIN_ID = int(os.getenv("ADMIN_ID", "8332196726"))
INVITES_FOR_CONTEST = int(os.getenv("INVITES_FOR_CONTEST", "15"))
NFT_LINK = os.getenv("NFT_LINK", "https://t.me/nft/MythMask-166243")

ANIMALS = ["🐺","🐻","🐻‍❄️","🐶","🐱","🦁","🐯","🐭","🦊","🐗","🐢","🐴","🐸","🐊"]

# =========================
# ХРАНИЛИЩЕ В ПАМЯТИ
# =========================
users: dict[int, dict] = {}
captcha_targets: dict[int, str] = {}

def get_user(user_id: int):
    return users.get(user_id)

def ensure_user(user_id: int, username: str, referrer_id=None):
    if user_id not in users:
        users[user_id] = {
            "username": username or "",
            "referrer_id": referrer_id,
            "captcha_ok": False,
            "joined_channel": False,
            "purchased_video": False,
            "invited_count": 0,
        }
    elif referrer_id and users[user_id]["referrer_id"] is None:
        users[user_id]["referrer_id"] = referrer_id
    return users[user_id]

def get_invited_count(user_id: int) -> int:
    u = users.get(user_id)
    return u["invited_count"] if u else 0

# =========================
# КЛАВИАТУРЫ
# =========================
def progress_bar(current: int, total: int = 5) -> str:
    filled = "▓" * min(current, total)
    empty = "░" * max(0, total - current)
    return f"│{filled}{empty}│ {current}/{total} приглашено"

def main_menu_kb() -> ReplyKeyboardMarkup:
    return ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="👤 Профиль")],
            [KeyboardButton(text="🔗 Моя ссылка")],
            [KeyboardButton(text="🏆 Конкурс")],
        ],
        resize_keyboard=True
    )

def captcha_kb(emojis: list[str]) -> InlineKeyboardMarkup:
    buttons = [InlineKeyboardButton(text=e, callback_data=f"cap:{e}") for e in emojis]
    rows = [buttons[i:i+3] for i in range(0, len(buttons), 3)]
    return InlineKeyboardMarkup(inline_keyboard=rows)

def channel_join_kb() -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="📢 Подать заявку в канал", url=CHANNEL_LINK)],
        [InlineKeyboardButton(text="✅ Я отправил заявку", callback_data="check_join")]
    ])

# =========================
# КАПЧА
# =========================
def generate_captcha():
    target = random.choice(ANIMALS)
    others = random.sample([e for e in ANIMALS if e != target], 8)
    emojis = [target] + others
    random.shuffle(emojis)
    return target, emojis

# =========================
# ХЕЛПЕРЫ
# =========================
async def show_profile(message: Message):
    invited = get_invited_count(message.from_user.id)
    contest = ("✅ Вы участвуете!" if invited >= INVITES_FOR_CONTEST
               else f"Нужно ещё {INVITES_FOR_CONTEST - invited}")
    await message.answer(
        f"👤 <b>Ваш профиль</b>\n\n"
        f"{progress_bar(invited)}\n"
        f"🏆 Конкурс (от {INVITES_FOR_CONTEST} чел.): {contest}\n"
        f"🎁 Награда за конкурс: <a href='{NFT_LINK}'>NFT MythMask</a>\n\n"
        f"🔗 Ваша ссылка — кнопка «Моя ссылка».",
        reply_markup=main_menu_kb(),
        parse_mode="HTML",
        disable_web_page_preview=True
    )

async def start_command(message: Message):
    user_id = message.from_user.id
    u = get_user(user_id) or ensure_user(user_id, message.from_user.username or "")

    if not u["captcha_ok"]:
        target, emojis = generate_captcha()
        captcha_targets[user_id] = target
        await message.answer(
            f"🐾 <b>Подтвердите, что вы человек</b>\n\n"
            f"Выберите животное: <b>{target}</b>",
            reply_markup=captcha_kb(emojis),
            parse_mode="HTML"
        )
        return

    if not u["joined_channel"]:
        await message.answer(
            "📢 Чтобы получать награды, подайте заявку в канал:",
            reply_markup=channel_join_kb()
        )
        return

    await show_profile(message)

# =========================
# ПОЛЬЗОВАТЕЛЬСКИЙ РОУТЕР
# =========================
user_router = Router()

@user_router.message(CommandStart(deep_link=True))
async def start_with_ref(message: Message, command: CommandObject):
    user_id = message.from_user.id
    referrer_id = None
    if command.args and command.args.isdigit():
        referrer_id = int(command.args)
        if referrer_id == user_id:
            await message.answer("❌ Нельзя перейти по своей же ссылке.")
            return

    existed = user_id in users
    ensure_user(user_id, message.from_user.username or "", referrer_id)
    if not existed and referrer_id:
        await message.answer("✅ Вы перешли по реферальной ссылке.")

    await start_command(message)

@user_router.message(CommandStart())
async def start_plain(message: Message):
    ensure_user(message.from_user.id, message.from_user.username or "")
    await start_command(message)

@user_router.callback_query(F.data.startswith("cap:"))
async def captcha_handler(cq: CallbackQuery):
    user_id = cq.from_user.id
    chosen = cq.data.split(":", 1)[1]
    target = captcha_targets.get(user_id)

    if not target:
        await cq.answer("Капча устарела. Нажмите /start", show_alert=True)
        return

    if chosen != target:
        await cq.answer("❌ Неверно. Попробуйте ещё раз.", show_alert=True)
        new_target, emojis = generate_captcha()
        captcha_targets[user_id] = new_target
        await cq.message.edit_text(
            f"🐾 <b>Подтвердите, что вы человек</b>\n\n"
            f"Выберите животное: <b>{new_target}</b>",
            reply_markup=captcha_kb(emojis),
            parse_mode="HTML"
        )
        return

    u = get_user(user_id) or ensure_user(user_id, cq.from_user.username or "")
    already_rewarded = bool(u["captcha_ok"] and u["joined_channel"])
    referrer_id = u["referrer_id"]

    await cq.answer("✅ Капча пройдена!")
    u["captcha_ok"] = True
    captcha_targets.pop(user_id, None)

    if referrer_id and not already_rewarded and referrer_id in users:
        users[referrer_id]["invited_count"] += 1
        try:
            cnt = users[referrer_id]["invited_count"]
            await cq.bot.send_message(
                referrer_id,
                f"🎉 По вашей ссылке пришёл новый участник!\n"
                f"{progress_bar(cnt)}"
            )
        except Exception:
            pass

    await cq.message.edit_text(
        "✅ Капча пройдена!\n\n"
        "📢 Теперь подайте заявку в канал:",
        reply_markup=channel_join_kb()
    )

@user_router.callback_query(F.data == "check_join")
async def check_join_handler(cq: CallbackQuery):
    user_id = cq.from_user.id
    u = get_user(user_id) or ensure_user(user_id, cq.from_user.username or "")
    u["joined_channel"] = True
    await cq.answer("✅ Заявка отмечена!")
    await cq.message.edit_text("✅ Заявка отмечена! Добро пожаловать.")
    await show_profile(cq.message)

@user_router.message(F.text == "🔗 Моя ссылка")
async def my_link(message: Message):
    ensure_user(message.from_user.id, message.from_user.username or "")
    link = await create_start_link(message.bot, str(message.from_user.id), encode=True)
    invited = get_invited_count(message.from_user.id)
    await message.answer(
        f"🔗 <b>Ваша реферальная ссылка:</b>\n\n"
        f"<code>{link}</code>\n\n"
        f"{progress_bar(invited)}\n"
        f"Скопируйте ссылку и отправьте другу.",
        parse_mode="HTML"
    )

@user_router.message(F.text == "👤 Профиль")
async def profile_btn(message: Message):
    ensure_user(message.from_user.id, message.from_user.username or "")
    await show_profile(message)

@user_router.message(F.text == "🏆 Конкурс")
async def contest_btn(message: Message):
    invited = get_invited_count(message.from_user.id)
    await message.answer(
        f"🏆 <b>Конкурс</b>\n\n"
        f"Нужно пригласить <b>{INVITES_FOR_CONTEST}</b> человек.\n"
        f"У вас: <b>{invited}</b>\n"
        f"{progress_bar(invited)}\n\n"
        f"🎁 Победитель получает NFT: {NFT_LINK}\n\n"
        f"📹 Если приглашённый купит любое видео в канале — ваш шанс +50%.",
        parse_mode="HTML",
        disable_web_page_preview=True
    )

# =========================
# АДМИНСКИЙ РОУТЕР
# =========================
admin_router = Router()
admin_router.message.filter(F.from_user.id == ADMIN_ID)

@admin_router.message(Command("stat"))
async def stat_handler(message: Message):
    total = len(users)
    captcha = sum(1 for u in users.values() if u["captcha_ok"])
    joined = sum(1 for u in users.values() if u["joined_channel"])
    purchased = sum(1 for u in users.values() if u["purchased_video"])

    top = sorted(users.items(), key=lambda kv: kv[1]["invited_count"], reverse=True)[:10]

    text = (
        f"📊 <b>Статистика</b>\n\n"
        f"👥 Всего пользователей: {total}\n"
        f"✅ Прошли капчу: {captcha}\n"
        f"📢 Отметили заявку: {joined}\n"
        f"📹 Купили видео: {purchased}\n\n"
        f"🏆 <b>Топ-10 по приглашениям:</b>\n"
    )
    for uid, u in top:
        name = f"@{u['username']}" if u["username"] else str(uid)
        marker = " ✅" if u["invited_count"] >= INVITES_FOR_CONTEST else ""
        text += f"{name} — {u['invited_count']}{marker}\n"

    await message.answer(text, parse_mode="HTML")

@admin_router.message(Command("m"))
async def broadcast_handler(message: Message):
    if message.reply_to_message:
        text = message.reply_to_message.text or message.reply_to_message.caption or ""
    else:
        parts = message.text.split(maxsplit=1)
        if len(parts) < 2:
            await message.answer("Использование: /m текст, или ответьте на сообщение командой /m")
            return
        text = parts[1]

    if not text:
        await message.answer("Пустое сообщение.")
        return

    sent = failed = 0
    for uid in list(users.keys()):
        try:
            await message.bot.send_message(uid, text)
            sent += 1
        except Exception:
            failed += 1

    await message.answer(f"📨 Рассылка завершена.\n✅ Отправлено: {sent}\n❌ Ошибок: {failed}")

# =========================
# ЗАПУСК
# =========================
async def main():
    bot = Bot(
        token=BOT_TOKEN,
        default=DefaultBotProperties(parse_mode=ParseMode.HTML)
    )
    dp = Dispatcher()
    dp.include_router(admin_router)
    dp.include_router(user_router)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
