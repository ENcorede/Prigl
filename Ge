import asyncio
import sqlite3
import os
import logging

from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

from aiogram import Bot, Dispatcher, F
from aiogram.types import ChatJoinRequest, Message
from aiogram.filters import Command

# ==============================
# НАСТРОЙКИ
# ==============================

TOKEN = os.getenv("BOT_TOCEN")

CHANNEL_ID = int(os.getenv("CHANNEL_ID", "0"))

ADMINS = {
    8332196726,
    5068550043,
    6977407005
}

TIMEZONE = ZoneInfo("Europe/Moscow")

DB_NAME = "statistics.db"

# ==============================
# ЛОГИ
# ==============================

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s"
)

logger = logging.getLogger(__name__)

# ==============================
# БАЗА ДАННЫХ
# ==============================

db = sqlite3.connect(DB_NAME)
db.row_factory = sqlite3.Row

db.execute("""
CREATE TABLE IF NOT EXISTS accepted (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    username TEXT,
    full_name TEXT,
    accepted_at TEXT NOT NULL
)
""")

db.execute("""
CREATE TABLE IF NOT EXISTS processed (
    user_id INTEGER PRIMARY KEY,
    processed_at TEXT NOT NULL
)
""")

db.commit()


def now():
    return datetime.now(TIMEZONE)


def save_accept(user_id, username, full_name):
    timestamp = now().isoformat()

    db.execute("""
        INSERT INTO accepted (
            user_id,
            username,
            full_name,
            accepted_at
        )
        VALUES (?, ?, ?, ?)
    """, (
        user_id,
        username,
        full_name,
        timestamp
    ))

    db.commit()


def was_processed(user_id):
    result = db.execute(
        "SELECT user_id FROM processed WHERE user_id = ?",
        (user_id,)
    ).fetchone()

    return result is not None


def mark_processed(user_id):
    db.execute("""
        INSERT OR IGNORE INTO processed (
            user_id,
            processed_at
        )
        VALUES (?, ?)
    """, (user_id, now().isoformat()))

    db.commit()


def get_count(start=None):
    if start:
        result = db.execute("""
            SELECT COUNT(*) AS total
            FROM accepted
            WHERE accepted_at >= ?
        """, (start.isoformat(),)).fetchone()
    else:
        result = db.execute("""
            SELECT COUNT(*) AS total
            FROM accepted
        """).fetchone()

    return result["total"]


def get_last():
    return db.execute("""
        SELECT *
        FROM accepted
        ORDER BY id DESC
        LIMIT 1
    """).fetchone()


# ==============================
# ФОРМАТИРОВАНИЕ ДАТЫ
# ==============================

MONTHS = [
    "января", "февраля", "марта",
    "апреля", "мая", "июня",
    "июля", "августа", "сентября",
    "октября", "ноября", "декабря"
]


def format_date(dt):
    return (
        f"{dt.day} {MONTHS[dt.month - 1]} "
        f"{dt.strftime('%H:%M')} {dt.year} год"
    )


# ==============================
# BOT
# ==============================

if not TOKEN:
    raise RuntimeError("Не найдена переменная BOT_TOCEN!")

if CHANNEL_ID == 0:
    raise RuntimeError("Не задан CHANNEL_ID!")

bot = Bot(token=TOKEN)
dp = Dispatcher()


# ==============================
# ЗАЯВКИ
# ==============================

@dp.chat_join_request()
async def join_request_handler(request: ChatJoinRequest):

    if request.chat.id != CHANNEL_ID:
        return

    user = request.from_user

    if was_processed(user.id):
        return

    try:
        # Принимаем заявку
        await bot.approve_chat_join_request(
            chat_id=request.chat.id,
            user_id=user.id
        )

        # Записываем статистику
        save_accept(
            user_id=user.id,
            username=user.username,
            full_name=user.full_name
        )

        mark_processed(user.id)

        username = (
            f"@{user.username}"
            if user.username
            else user.full_name
        )

        message = (
            "┌ Заявка принята ➕\n"
            f"├ {username}\n"
            f"├ id: {user.id}\n"
            f"└ {format_date(now())}"
        )

        # Уведомляем администраторов
        for admin_id in ADMINS:
            try:
                await bot.send_message(
                    chat_id=admin_id,
                    text=message
                )
            except Exception as e:
                logger.warning(
                    f"Не удалось отправить уведомление {admin_id}: {e}"
                )

        logger.info(
            f"Принята заявка: {user.id} (@{user.username})"
        )

    except Exception as e:
        logger.exception(
            f"Ошибка обработки заявки {user.id}: {e}"
        )


# ==============================
# СТАТИСТИКА
# ==============================

@dp.message(Command("stat"))
async def statistics(message: Message):

    if message.from_user.id not in ADMINS:
        return

    current = now()

    today_start = current.replace(
        hour=0,
        minute=0,
        second=0,
        microsecond=0
    )

    week_start = current - timedelta(days=7)

    month_start = current.replace(
        day=1,
        hour=0,
        minute=0,
        second=0,
        microsecond=0
    )

    total = get_count()
    today = get_count(today_start)
    week = get_count(week_start)
    month = get_count(month_start)

    # Участники канала
    try:
        members = await bot.get_chat_member_count(CHANNEL_ID)
        members_text = str(members)
    except Exception:
        members_text = "Недоступно"

    # Последняя заявка
    last = get_last()

    if last:
        last_dt = datetime.fromisoformat(last["accepted_at"])

        last_user = (
            f"@{last['username']}"
            if last["username"]
            else last["full_name"]
        )

        last_text = (
            f"{last_user}\n"
            f"ID: {last['user_id']}\n"
            f"{format_date(last_dt)}"
        )
    else:
        last_text = "Пока заявок нет"

    text = (
        "📊 <b>Статистика канала</b>\n"
        "\n"
        f"👥 Участников канала: <b>{members_text}</b>\n"
        "\n"
        "📥 <b>Принятые заявки</b>\n"
        f"├ Всего: <b>{total}</b>\n"
        f"├ Сегодня: <b>{today}</b>\n"
        f"├ За 7 дней: <b>{week}</b>\n"
        f"└ За месяц: <b>{month}</b>\n"
        "\n"
        "🕒 <b>Последняя заявка</b>\n"
        f"{last_text}\n"
        "\n"
        f"📅 Обновлено: {format_date(current)}"
    )

    await message.answer(
        text,
        parse_mode="HTML"
    )


# ==============================
# ЗАПУСК
# ==============================

async def main():
    logger.info("Бот запущен!")

    await dp.start_polling(
        bot,
        allowed_updates=dp.resolve_used_update_types()
    )


if __name__ == "__main__":
    try:
        asyncio.run(main())
    finally:
        db.close()
