@router.callback_query(F.data.startswith("lot_cancel:"))
async def cb_lot_cancel(call: CallbackQuery, bot: Bot):
    lot_id = int(call.data.split(":")[1])
    lot = lots.get(lot_id)
    if not lot:
        await call.answer("Нет лота", show_alert=True)
        return
    if call.from_user.id != lot["owner"] and not is_admin(call.from_user.id):
        await call.answer("Не ваш лот", show_alert=True)
        return
    joiner = lot.get("joiner")
    if joiner:
        try:
            await bot.send_message(joiner, "❌ Обмен был отменён.")
        except Exception:
            pass
    lots.pop(lot_id, None)
    user_to_lot.pop(lot["owner"], None)
    await safe_edit(call, "❌ Лот отменён.", back_kb())
    await call.answer("Отменено")

