admin_router = Router()
admin_router.message.filter(
    F.from_user.id == ADMIN_ID
)


@admin_router.message(Command("stat"))
async def stat_handler(message: Message):
    total = len(users)

    captcha = sum(
        1 for u in users.values()
        if u["captcha_ok"]
    )

    joined = sum(
        1 for u in users.values()
        if u["joined_channel"]
    )

    purchased = sum(
        1 for u in users.values()
        if u["purchased_video"]
    )

    top = sorted(
        users.items(),
        key=lambda kv: kv[1]["invited_count"],
        reverse=True
    )[:10]

    text = (
        f"📊 <b>Статистика</b>\n\n"
        f"👥 Всего пользователей: {total}\n"
        f"✅ Прошли капчу: {captcha}\n"
        f"📢 Подтвердили канал: {joined}\n"
        f"📹 Купили видео: {purchased}\n\n"
        f"🏆 <b>Топ-10 по приглашениям:</b>\n"
    )

    for uid, u in top:
        name = (
            f"@{u['username']}"
            if u["username"]
            else str(uid)
        )

        marker = (
            " ✅"
            if u["invited_count"] >= INVITES_FOR_CONTEST
            else ""
        )

        text += (
            f"{name} — {u['invited_count']}{marker}\n"
        )

    await message.answer(text)


# =========================
