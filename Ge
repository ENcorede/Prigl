def build_lots_list(page: int, user_id: int):
    active = [l for l in lots.values() if l["status"] == "active"]
    active.sort(key=lambda l: (not is_premium(l["owner"]), -l["created"].timestamp()))

    per = 5
    total = max(1, (len(active) + per - 1) // per)
    page = max(0, min(page, total - 1))
    items = active[page * per:(page + 1) * per]

    text = f"🔁 <b>Успешных обменов</b>\n\n📄 Страница {page + 1}/{total}\n\n"
    kb = []

    if not items:
        text += "Пока нет активных лотов.\n"
    else:
        for i, lot in enumerate(items):
            prem = "💎 " if is_premium(lot["owner"]) else ""
            t = lot["text"][:80].replace("<", "&lt;").replace(">", "&gt;")
            if len(lot["text"]) > 80:
                t += "…"
            text += (
                f"<b>Лот #{i + 1}</b> {prem}\n"
                f"{t}\n"
                f"🔁 Успешных обменов: {success_count.get(lot['owner'], 0)}\n\n"
            )
            kb.append([InlineKeyboardButton(text=f"Открыть лот #{i + 1}", callback_data=f"lot_view:{lot['id']}")])

    kb.append([
        InlineKeyboardButton(text="◀️", callback_data=f"lots_page:{page - 1}"),
        InlineKeyboardButton(text="Обновить 🔁", callback_data=f"lots_page:{page}"),
        InlineKeyboardButton(text="▶️", callback_data=f"lots_page:{page + 1}"),
    ])

    if user_id in user_to_lot:
        kb.append([InlineKeyboardButton(text="Мой лот 📦", callback_data=f"lot_view:{user_to_lot[user_id]}")])
    else:
        kb.append([InlineKeyboardButton(text="Создать лот ➕", callback_data="lot_create")])

    kb.append([InlineKeyboardButton(text="< Выйти", callback_data="menu_main")])
    return text, InlineKeyboardMarkup(inline_keyboard=kb)

