@router.message(Command("m"))
async def cmd_m(message: Message, command: CommandObject, bot: Bot):
    if not is_admin(message.from_user.id):
        return
    if not command.args:
        return
    args = command.args.strip()
    if args.startswith("@"):
        parts = args.split(" ", 1)
        username = parts[0]
        text = parts[1] if len(parts) > 1 else ""
        uid = resolve_user(username)
        if not uid:
            await message.answer("Не найден")
            return
        try:
            await bot.send_message(uid, f"📩 Сообщение от администрации:\n\n{text}")
            await message.answer("✅ Отправлено")
        except Exception as e:
            await message.answer(f"Ошибка: {e}")
    else:
        sent = 0
        seen = set()
        for uid in known_users.values():
            if uid in seen or uid in banned:
                continue
            seen.add(uid)
            try:
                await bot.send_message(uid, f"📢 Сообщение от администрации:\n\n{args}")
                sent += 1
            except Exception:
                pass
        await message.answer(f"✅ Отправлено {sent} пользователям")

