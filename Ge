@router.message(Command("m"))
async def cmd_m(message: Message):
    if message.from_user.id not in ADMIN_IDS:
        return
    args = message.text[3:].strip() if len(message.text) > 3 else ""
    if not args:
        await message.answer("Использование: /m @username текст  ИЛИ  /m текст")
        return

    if args.startswith('@'):
        parts = args.split(' ', 1)
        uname = parts[0][1:]
        text = parts[1] if len(parts) > 1 else ""
        if not text:
            await message.answer("Введите текст сообщения")
            return
        target = await resolve_user(uname)
        if not target:
            await message.answer("Пользователь не найден")
            return
        try:
            sent = await bot.send_message(target, text)
            await message.answer(
                f"✅ Отправлено <code>{target}</code>",
                reply_markup=InlineKeyboardMarkup(inline_keyboard=[[
                    InlineKeyboardButton(
                        text="🗑 Удалить",
                        callback_data=f"del_{target}_{sent.message_id}"
                    )
                ]])
            )
        except Exception as e:
            await message.answer(f"⚠️ Ошибка: {e}")
    else:
        count = 0
        for uid in list(bot_users):
            if uid in banned:
                continue
            try:
                await bot.send_message(uid, args)
                count += 1
            except Exception:
                pass
        await message.answer(f"✅ Рассылка отправлена: {count} пользователям")

