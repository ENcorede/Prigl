@router.message(S.ex_media)
async def h_ex_media(message: Message, state: FSMContext):
    global lot_id_seq
    if not is_media(message):
        await message.answer("❗ Отправьте фото или видео.")
        return
    data = await state.get_data()
    lot_text = data.get("ex_text")
    if not lot_text:
        await message.answer("Ошибка, начните заново.")
        await state.clear()
        return
    if message.from_user.id in user_to_lot:
        await message.answer("У вас уже есть лот.")
        await state.clear()
        return

    lot_id_seq += 1
    lot_id = lot_id_seq
    lots[lot_id] = {
        "id": lot_id,
        "owner": message.from_user.id,
        "text": lot_text,
        "media": (message.chat.id, message.message_id),
        "created": datetime.now(),
        "status": "active",
        "joiner": None,
        "joiner_media": None,
    }
    user_to_lot[message.from_user.id] = lot_id
    await state.clear()
    await message.answer("✅ Лот создан и опубликован в ленте!")

