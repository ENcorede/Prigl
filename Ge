@router.message(Command("prem"))
async def cmd_prem(message: Message, command: CommandObject):
    if not is_admin(message.from_user.id):
        return
    if not command.args:
        await message.answer("Использование: /prem @username")
        return
    uid = resolve_user(command.args)
    if not uid:
        await message.answer("Пользователь не найден (пусть напишет /start)")
        return
    current = premium_until.get(uid)
    base = current if (current and current > datetime.now()) else datetime.now()
    premium_until[uid] = base + timedelta(days=30)
    try:
        await message.bot.send_message(uid, "💎 Вам выдан PREMIUM на месяц!")
    except Exception:
        pass
    await message.answer(f"✅ Премиум выдан {uid}")

@router.message(Command("unprem"))
async def cmd_unprem(message: Message, command: CommandObject):
    if not is_admin(message.from_user.id):
        return
    if not command.args:
        return
    uid = resolve_user(command.args)
    if uid and uid in premium_until:
        premium_until.pop(uid, None)
        await message.answer(f"✅ Премиум забран у {uid}")
    else:
        await message.answer("Пользователь не был премиум")

