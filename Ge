@user_router.chat_join_request()
async def auto_approve_request(event: ChatJoinRequest):
    user_id = event.from_user.id
    chat_id = event.chat.id

    # Проверяем, что заявка пришла именно в нужный канал
    if chat_id != CHANNEL_ID:
        return

    u = get_user(user_id)

    # Не принимаем заявки пользователей,
    # которые не прошли капчу в боте.
    if not u or not u["captcha_ok"]:
        try:
            await event.bot.decline_chat_join_request(
                chat_id=chat_id,
                user_id=user_id
            )
        except Exception:
            pass

        return

    try:
        # Автоматически принимаем заявку
        await event.bot.approve_chat_join_request(
            chat_id=chat_id,
            user_id=user_id
        )

        # Обновляем данные пользователя
        u["joined_channel"] = True

        u["username"] = (
            event.from_user.username or u["username"]
        )

        # Уведомляем пользователя
        try:
            await event.bot.send_message(
                user_id,
                "🎉 <b>Ваша заявка автоматически одобрена!</b>\n\n"
                "✅ Вы успешно вступили в канал.\n"
                "👤 Теперь вам доступен профиль.",
            )

            await event.bot.send_message(
                user_id,
                f"👤 <b>Ваш профиль</b>\n\n"
                f"{progress_bar(u['invited_count'])}\n"
                f"🏆 Конкурс (от {INVITES_FOR_CONTEST} чел.): "
                f"{'✅ Вы участвуете!' if u['invited_count'] >= INVITES_FOR_CONTEST else f'Нужно ещё {INVITES_FOR_CONTEST - u['invited_count']}'}\n"
                f"🎁 Награда: <a href='{NFT_LINK}'>NFT MythMask</a>\n\n"
                f"🔗 Ваша ссылка — кнопка «Моя ссылка».",
                reply_markup=main_menu_kb(),
                disable_web_page_preview=True
            )

        except Exception:
            pass

    except Exception as e:
        print(
            f"Ошибка автоматического принятия заявки "
            f"{user_id}: {e}"
        )


