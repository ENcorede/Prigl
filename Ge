@router.message(S.join_media)
async def h_join_media(message: Message, state: FSMContext, bot: Bot):
    if not is_media(message):
        await message.answer("❗ Отправьте фото или видео.")
        return
    data = await state.get_data()
    lot_id = data.get("join_lot")
    lot = lots.get(lot_id) if lot_id else None
    if not lot or lot["status"] != "active":
        await message.answer("Лот больше недоступен.")
        await state.clear()
        return
    if lot["owner"] == message.from_user.id:
        await message.answer("Это ваш лот.")
        await state.clear()
        return

    lot["status"] = "pending"
    lot["joiner"] = message.from_user.id
    lot["joiner_media"] = (message.chat.id, message.message_id)

    admin_kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="Разрешить ✅", callback_data=f"admin_approve:{lot_id}")],
        [InlineKeyboardButton(text="Отклонить ❌", callback_data=f"admin_reject:{lot_id}")],
    ])
    for aid in ADMIN_IDS:
        try:
            await bot.send_message(
                aid,
                f"🔔 Новый обмен #{lot_id}\n"
                f"Владелец: {lot['owner']}\n"
                f"Участник: {lot['joiner']}\n\nМедиа владельца:",
            )
            await bot.copy_message(aid, lot["media"][0], lot["media"][1])
            await bot.send_message(aid, "Медиа участника:")
            await bot.copy_message(aid, message.chat.id, message.message_id, reply_markup=admin_kb)
        except Exception as e:
            logging.error(f"admin notify obm: {e}")
    await message.answer("✅ Ваш обмен отправлен на проверку администрации. Ожидайте.")
    await state.clear()

