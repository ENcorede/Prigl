@router.callback_query(F.data == "lot_ready")
async def lot_create_finish(cb: CallbackQuery, state: FSMContext):
    global next_lot_id
    data = await state.get_data()
    text = data.get('lot_text')
    media = data.get('lot_media', [])
    if not text or not media:
        await cb.answer("Ошибка: нет текста или медиа", show_alert=True)
        return

    prem = is_premium(cb.from_user.id)
    hours = 24 if prem else 12

    lot = {
        'id': next_lot_id,
        'owner': cb.from_user.id,
        'text': text,
        'media': media,
        'created': datetime.now(),
        'expires': datetime.now() + timedelta(hours=hours),
        'status': 'open',
        'premium': prem,
        'entrant': None,
        'entrant_media': [],
    }
    lots[next_lot_id] = lot
    next_lot_id += 1
    await state.clear()
    await cb.answer("Лот создан!")
    await show_feed(cb, page=0)

# ---- Вход в обмен ----
@router.callback_query(F.data.startswith("join_"))
async def join_lot(cb: CallbackQuery, state: FSMContext):
    lot_id = int(cb.data.split("_")[1])
    lot = lots.get(lot_id)
    if not lot or lot['status'] != 'open':
        await cb.answer("Лот недоступен", show_alert=True)
        return
    if lot['owner'] == cb.from_user.id:
        await cb.answer("Это ваш лот", show_alert=True)
        return
    if user_active_exchange(cb.from_user.id):
        await cb.answer("У вас уже есть активный обмен", show_alert=True)
        return

    # Показать медиа владельца
    await cb.message.answer(
        f"Вы входите в обмен #{lot_id}. Медиа владельца лота:"
    )
    for m in lot['media']:
        await send_media(cb.from_user.id, m)

    await state.update_data(join_lot_id=lot_id, entrant_media=[])
    await state.set_state(S.exchange_media)
    await cb.message.answer(
        "📎 Отправьте ваши фото/видео для обмена:",
        reply_markup=cancel_kb()
    )
    await cb.answer()

