    if entrant:
        try:
            await bot.send_message(entrant, f"❌ Ваша заявка на обмен #{lot_id} отклонена.")
        except Exception:
            pass

    await cb.message.edit_text(f"❌ Обмен #{lot_id} отклонён")
    await cb.answer("Отклонено")

# ---- Отмена обмена ----
@router.callback_query(F.data.startswith("cancel_"))
async def cancel_lot(cb: CallbackQuery, state: FSMContext):
    lot_id = int(cb.data.split("_")[1])
    lot = lots.get(lot_id)
    if not lot:
        await cb.answer("Лот не найден", show_alert=True)
        return
    uid = cb.from_user.id
    is_owner = lot['owner'] == uid
    is_entrant = lot.get('entrant') == uid
    if not (is_owner or is_entrant):
        await cb.answer("Нет прав", show_alert=True)
        return
    if lot['status'] not in ('open', 'pending'):
        await cb.answer("Обмен уже завершён", show_alert=True)
        return

    old_status = lot['status']
    other = lot['entrant'] if is_owner else lot['owner']
    lot['status'] = 'cancelled'

    if old_status == 'pending' and other:
        try:
            await bot.send_message(other, f"❌ Обмен #{lot_id} отменён")
        except Exception:
            pass

    await cb.answer("Обмен отменён")
    await show_feed(cb, page=0)

