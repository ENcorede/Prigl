async def lot_cleanup():
    while True:
        await asyncio.sleep(60)
        now = datetime.now()
        for lot_id, lot in list(lots.items()):
            if lot['status'] in ('open', 'pending') and lot['expires'] < now:
                lot['status'] = 'cancelled'
                try:
                    await bot.send_message(lot['owner'], f"⏰ Ваш лот #{lot_id} истёк.")
                except Exception:
                    pass
                if lot.get('entrant'):
                    try:
                        await bot.send_message(
                            lot['entrant'],
                            f"⏰ Обмен #{lot_id} истёк."
                        )
                    except Exception:
                        pass

