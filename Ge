@user_router.callback_query(F.data == "check_join")
async def check_join_handler(cq: CallbackQuery):
    user_id = cq.from_user.id

    try:
        member = await cq.bot.get_chat_member(
            CHANNEL_ID,
            user_id
        )

        status = member.status

    except Exception:
        await cq.answer(
            "❌ Не удалось проверить подписку.",
            show_alert=True
        )
        return

    if status in ("member", "administrator", "creator"):
        u = get_user(user_id) or ensure_user(
            user_id,
            cq.from_user.username or ""
        )

        u["joined_channel"] = True

        await cq.answer("✅ Подписка подтверждена!")

        await cq.message.edit_text(
            "✅ Подписка подтверждена! Добро пожаловать."
        )

        await show_profile(cq.message)

    else:
        await cq.answer(
            "⏳ Заявка ещё не одобрена. Попробуйте немного позже.",
            show_alert=True
        )


