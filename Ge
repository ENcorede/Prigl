def is_premium(user_id: int) -> bool:
    exp = premium.get(user_id)
    if not exp:
        return False
    if exp < datetime.now():
        premium.pop(user_id, None)
        return False
    return True

def user_active_exchange(user_id: int):
    for lot in lots.values():
        if lot['status'] in ('open', 'pending'):
            if lot['owner'] == user_id or lot.get('entrant') == user_id:
                return lot
    return None

def get_open_lots():
    return sorted(
        [l for l in lots.values() if l['status'] == 'open'],
        key=lambda x: x['created'], reverse=True
    )

async def safe_edit(target, text: str, kb=None, parse_mode="HTML"):
    """Пытается отредактировать сообщение; если нельзя — удаляет и шлёт новое."""
    cb = target
    try:
        await cb.message.edit_text(
            text, reply_markup=kb, parse_mode=parse_mode,
            disable_web_page_preview=True
        )
    except Exception:
        try:
            await cb.message.delete()
        except Exception:
            pass
        await cb.message.answer(
            text, reply_markup=kb, parse_mode=parse_mode,
            disable_web_page_preview=True
        )

async def send_media(chat_id, media: dict, caption: Optional[str] = None, kb=None):
    try:
        if media['type'] == 'photo':
            await bot.send_photo(chat_id, media['file_id'], caption=caption, reply_markup=kb)
        else:
            await bot.send_video(chat_id, media['file_id'], caption=caption, reply_markup=kb)
    except Exception as e:
        logging.warning(f"send_media error: {e}")

async def resolve_user(arg: str) -> Optional[int]:
    uname = arg.lstrip('@').lower()
    if uname in users_by_username:
        return users_by_username[uname]
    try:
        chat = await bot.get_chat(f"@{uname}")
        return chat.id
    except Exception:
        return None

# ============================================================
# MIDDLEWARE: бан + трекинг юзеров
# ============================================================
class UserMiddleware(BaseMiddleware):
    async def __call__(self, handler, event: TelegramObject, data):
        user = data.get('event_from_user')
        if user:
            if user.id in banned:
                if isinstance(event, Message):
                    await event.answer(BAN_MSG)
                elif isinstance(event, CallbackQuery):
                    try:
                        await event.answer(BAN_MSG, show_alert=True)
                    except Exception:
                        pass
                return
            bot_users.add(user.id)
            if user.username:
                users_by_username[user.username.lower()] = user.id
        return await handler(event, data)

dp.message.middleware(UserMiddleware())
dp.callback_query.middleware(UserMiddleware())

