# ================== MIDDLEWARE ==================
class UserTrackMiddleware(BaseMiddleware):
    async def __call__(self, handler, event, data):
        u = data.get("event_from_user")
        if u:
            if u.username:
                known_users[u.username.lower()] = u.id
            known_users[str(u.id)] = u.id
        return await handler(event, data)

class BanMiddleware(BaseMiddleware):
    async def __call__(self, handler, event, data):
        u = data.get("event_from_user")
        if u and u.id in banned and u.id not in ADMIN_IDS:
            try:
                if isinstance(event, Message):
                    await event.answer("❌ ВАС ЗАБАНИЛИ В БОТЕ")
                elif isinstance(event, CallbackQuery):
                    await event.answer("❌ ВАС ЗАБАНИЛИ В БОТЕ", show_alert=True)
            except Exception:
                pass
            return
        return await handler(event, data)

# ================== УТИЛИТЫ ==================
def is_admin(uid): return uid in ADMIN_IDS

def is_premium(uid):
    exp = premium_until.get(uid)
    return bool(exp and exp > datetime.now())

def resolve_user(arg: str):
    arg = arg.strip().lstrip("@")
    if arg.isdigit():
        return int(arg)
    return known_users.get(arg.lower())

def is_media(m: Message):
    return bool(
        m.photo or m.video
        or (m.document and m.document.mime_type and
            (m.document.mime_type.startswith("video/") or m.document.mime_type.startswith("image/")))
    )

async def safe_edit(call: CallbackQuery, text: str, kb=None):
    try:
        await call.message.edit_text(
            text, reply_markup=kb, parse_mode=ParseMode.HTML, disable_web_page_preview=True
        )
        return
    except Exception as e:
        if "not modified" in str(e).lower():
            return
    try:
        await call.message.edit_caption(caption=text, reply_markup=kb, parse_mode=ParseMode.HTML)
        return
    except Exception:
        pass
    try:
        await call.message.delete()
    except Exception:
        pass
    try:
        await call.message.answer(
            text, reply_markup=kb, parse_mode=ParseMode.HTML, disable_web_page_preview=True
        )
    except Exception:
        pass

