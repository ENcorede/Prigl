@router.message(AS.reply)
async def h_admin_reply(message: Message, state: FSMContext, bot: Bot):
    if not is_admin(message.from_user.id):
        return
    data = await state.get_data()
    uid = data.get("reply_to")
    caption = data.get("reply_caption", "")
    if not uid:
        await state.clear()
        return
    try:
        if message.text:
            txt = f"{caption}\n\n{message.text}" if caption else message.text
            await bot.send_message(uid, txt)
        else:
            await message.copy_to(uid, caption=caption or None)
        await message.answer("✅ Отправлено")
    except Exception as e:
        await message.answer(f"Ошибка: {e}")
    await state.clear()

