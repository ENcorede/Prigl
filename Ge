async def show_feed(cb: CallbackQuery, page: int = 0):
    user_id = cb.from_user.id
    open_lots = get_open_lots()
    total = len(open_lots)
    total_pages = max(1, total)
    page = max(0, min(page, total_pages - 1))

    header = f"🔁 Успешных обменов: {exchange_success.get(user_id, 0)}\n\n"

    buttons = []

    if total == 0:
        body = "Пока нет активных лотов"
        buttons.append([InlineKeyboardButton(text="Создать лот ➕", callback_data="create_lot")])
    else:
        lot = open_lots[page]
        owner = lot['owner']
        prem = lot.get('premium', False)
        owner_count = exchange_success.get(owner, 0)
        safe_text = lot['text'].replace('<', '&lt;').replace('>', '&gt;')

        if prem:
            body = (
                "💎 <b>ПРЕМИУМ ПОЛЬЗОВАТЕЛЬ</b> 💎\n"
                f"<b><u>{safe_text}</u></b>\n"
                f"🔁 Успешных обменов: {owner_count}"
            )
        else:
            body = f"{safe_text}\n🔁 Успешных обменов: {owner_count}"

        if owner == user_id:
            buttons.append([InlineKeyboardButton(
                text="Отменить обмен ❌", callback_data=f"cancel_{lot['id']}"
            )])
        else:
            if user_active_exchange(user_id):
                buttons.append([InlineKeyboardButton(
                    text="У вас уже есть обмен", callback_data="noop"
                )])
            else:
                buttons.append([InlineKeyboardButton(
                    text="Войти в обмен ▶️", callback_data=f"join_{lot['id']}"
                )])

    # Показать активный обмен (если есть, но это не лот который показывается)
    active = user_active_exchange(user_id)
    if active and (total == 0 or open_lots[page]['id'] != active['id']):
        if active['status'] == 'pending':
            body += f"\n\n⏳ Ваш обмен #{active['id']} на проверке"
        elif active['status'] == 'open':
            body += f"\n\n📝 Ваш лот #{active['id']} активен"

    # Навигация
    left = "◀️"
    right = "▶️"
    nav = InlineKeyboardMarkup  # placeholder

    left_cb = f"exch_{page-1}" if page > 0 else "noop"
    right_cb = f"exch_{page+1}" if page < total_pages - 1 else "noop"
    buttons.append([
        InlineKeyboardButton(text=left, callback_data=left_cb),
        InlineKeyboardButton(text="🔁", callback_data=f"exch_{page}"),
        InlineKeyboardButton(text=right, callback_data=right_cb),
    ])
    buttons.append([InlineKeyboardButton(
        text=f"Страница {page+1}/{total_pages}", callback_data="noop"
    )])
    buttons.append([InlineKeyboardButton(text="< Выйти", callback_data="main_menu")])

    kb = InlineKeyboardMarkup(inline_keyboard=buttons)
    await safe_edit(cb, header + body, kb)


